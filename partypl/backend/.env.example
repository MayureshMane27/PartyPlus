# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (Neon / Railway / local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/partypl

# JWT
JWT_SECRET=partypl-super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=30d

# CORS — frontend URL
CORS_ORIGIN=http://localhost:5173
